# Copy this file to terraform.tfvars and fill in real values.
# terraform.tfvars is git-ignored and must NEVER be committed with real values.

aws_region   = "us-west-2"
project_name = "lesson-7"

# Глобально унікальне ім'я S3-бакета для стану. Якщо вже застосовував(-ла)
# гілку lesson-7 — підстав те саме ім'я бакета, це той самий стейт.
state_bucket_name     = "REPLACE-ME-terraform-state-bucket-name"
state_lock_table_name = "terraform-state-lock"

vpc_cidr             = "10.0.0.0/16"
availability_zones   = ["us-west-2a", "us-west-2b", "us-west-2c"]
public_subnet_cidrs  = ["10.0.0.0/24", "10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.10.0/24", "10.0.11.0/24", "10.0.12.0/24"]

single_nat_gateway = true

ecr_repository_name      = "lesson-7-django-app"
ecr_image_tag_mutability = "MUTABLE"
ecr_max_image_count      = 10

eks_cluster_name    = "lesson-7-eks"
eks_cluster_version = "1.34"

node_instance_types = ["t3.medium"]
node_desired_size   = 2
node_min_size       = 2
node_max_size       = 4

github_owner = "Nazarovv676"
github_repo  = "microservice-project"

# Personal Access Token зі scope "repo" — потрібен Jenkins (git push у
# lesson-8-9) і Argo CD (клонування репозиторію). Створюється в GitHub →
# Settings → Developer settings → Personal access tokens.
github_username = "REPLACE-ME-github-username"
github_pat      = "REPLACE-ME-github-pat"

app_chart_path      = "charts/django-app"
app_target_revision = "lesson-8-9"
app_namespace       = "default"

jenkins_namespace     = "jenkins"
jenkins_chart_version = "5.9.45"
jenkins_service_type  = "LoadBalancer"

argocd_namespace           = "argocd"
argocd_chart_version       = "7.7.11"
argocd_server_service_type = "LoadBalancer"

# RDS: залиш use_aurora = false для звичайної RDS-інстанції (дешевше для
# навчання), постав true — щоб отримати Aurora-кластер. Дивись
# modules/rds/README.md за повним описом усіх rds_* змінних.
rds_identifier      = "django-db"
rds_use_aurora      = false
rds_engine          = "postgres"
rds_engine_version  = "16.4"
# aurora-режим вимагає іншу родину parameter group:
# rds_parameter_group_family = "aurora-postgresql16"
rds_parameter_group_family = "postgres16"
rds_instance_class         = "db.t3.medium"
rds_allocated_storage      = 20
rds_multi_az                = false
rds_aurora_instance_count  = 1
rds_db_name                 = "django_app"
rds_master_username        = "app_admin"
rds_deletion_protection    = false
rds_skip_final_snapshot    = true
