# ==============================================================================
# Стейт lesson-7 зберігається у ТОМУ Ж S3-бакеті/DynamoDB-таблиці, які були
# створені модулем `s3-backend` у lesson-5 (bootstrap там уже виконано, тож
# повторювати його тут не потрібно) — просто інший `key`, щоб стейти не
# перезаписували один одного.
#
# Підстав своє реальне ім'я бакета замість "REPLACE-WITH-YOUR-STATE-BUCKET-NAME"
# (те саме ім'я, що використовувалось у lesson-5/terraform.tfvars). Backend-блоки
# Terraform не підтримують інтерполяцію змінних, тому значення прописується
# буквально.
# ==============================================================================

terraform {
  backend "s3" {
    bucket         = "terraform-state-lesson-5-430383499929"
    key            = "lesson-7/terraform.tfstate"
    region         = "us-west-2"
    dynamodb_table = "terraform-state-lock"
    encrypt        = true
  }
}
