# Copy this file to terraform.tfvars and fill in real values.
# terraform.tfvars is git-ignored and must NEVER be committed with real values.

aws_region   = "us-west-2"
project_name = "lesson-5"

# S3 bucket names are globally unique across ALL AWS accounts.
# Replace with your own, e.g. "<your-name>-terraform-state-lesson-5"
state_bucket_name     = "REPLACE-ME-terraform-state-lesson-5"
state_lock_table_name = "terraform-state-lock"

vpc_cidr             = "10.0.0.0/16"
availability_zones   = ["us-west-2a", "us-west-2b", "us-west-2c"]
public_subnet_cidrs  = ["10.0.0.0/24", "10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.10.0/24", "10.0.11.0/24", "10.0.12.0/24"]

# true  = 1 shared NAT Gateway (cheaper, single point of failure)
# false = 1 NAT Gateway per AZ (higher availability, ~3x cost)
single_nat_gateway = true

ecr_repository_name      = "lesson-5-app"
ecr_image_tag_mutability = "MUTABLE"
ecr_max_image_count      = 10
